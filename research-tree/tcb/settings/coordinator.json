{
  "permissions": {
    "allow": [
      "Read(//{root}/run/status.json)",
      "Read(//{root}/views/**)",
      "Read(//{root}/store/objects/x_*)",
      "Read(//{root}/completeness/gate.json)",
      "Read(//{root}/plan/**)",
      "Read(//{root}/tcb/briefs/**)",
      "Read(//{root}/tcb/README.md)",
      "Edit(//{root}/plan/questions/**)",
      "Write(//{root}/plan/questions/**)",
      "Edit(//{root}/plan/approaches.json)",
      "Write(//{root}/plan/approaches.json)",
      "Edit(//{root}/plan/protocols/**)",
      "Write(//{root}/plan/protocols/**)",
      "Edit(//{root}/plan/analysis-plan.json)",
      "Write(//{root}/plan/analysis-plan.json)",
      "Edit(//{root}/plan/cost-inputs.json)",
      "Write(//{root}/plan/cost-inputs.json)",
      "Edit(//{root}/plan/tasks-plan.json)",
      "Write(//{root}/plan/tasks-plan.json)",
      "Edit(//{root}/plan/plant-candidates/**)",
      "Write(//{root}/plan/plant-candidates/**)",
      "Edit(//{root}/plan/our-work/**)",
      "Write(//{root}/plan/our-work/**)",
      "Edit(//{root}/plan/notes/**)",
      "Write(//{root}/plan/notes/**)",
      "Agent(checker)",
      "Agent(mapper)",
      "Bash(node tcb/scripts/*)"
    ],
    "deny": [
      "NotebookEdit",
      "MultiEdit",
      "WebSearch",
      "Task",
      "WebFetch",
      "Edit(//{root}/tcb/**)",
      "Write(//{root}/tcb/**)",
      "Edit(//{root}/run/**)",
      "Write(//{root}/run/**)",
      "Edit(//{root}/store/**)",
      "Write(//{root}/store/**)",
      "Edit(//{root}/sealed/**)",
      "Write(//{root}/sealed/**)",
      "Edit(//{root}/review-in/**)",
      "Write(//{root}/review-in/**)",
      "Edit(//{root}/.git/**)",
      "Write(//{root}/.git/**)",
      "Edit(//{root}/wt/**)",
      "Write(//{root}/wt/**)",
      "Edit(//{root}/plan/frozen/**)",
      "Write(//{root}/plan/frozen/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"{node}\" \"{root}/tcb/scripts/guard-hook.mjs\" --root \"{root}\" --role coordinator",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
