{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qualification",
  "description": "store/qualification.json (CONTRACT 3.22, spec/seed.mjs.md step 6), written by seed score. Readers use classes.<C>.qualified and escape {n, escaped}.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "d0", "beta", "n_required", "batches", "classes", "false_alarm", "escape", "plants", "result"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "d0": { "type": ["number", "null"] },
    "beta": { "type": ["number", "null"] },
    "n_required": { "type": ["integer", "null"], "minimum": 0 },
    "batches": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rng_seed", "transcript_sha256", "items", "n_real", "flagged", "duplicates", "unknown_items"],
        "properties": {
          "rng_seed": { "type": "string" },
          "transcript_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item", "class", "verdict", "detected", "named"],
              "properties": {
                "item": { "type": "string", "minLength": 1 },
                "class": { "type": "string", "minLength": 1 },
                "verdict": { "type": ["string", "null"] },
                "detected": { "type": "boolean" },
                "named": { "type": "boolean" }
              }
            }
          },
          "n_real": { "type": "integer", "minimum": 0 },
          "flagged": { "type": "integer", "minimum": 0 },
          "duplicates": { "type": "integer", "minimum": 0 },
          "unknown_items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["qualified"],
        "properties": { "qualified": { "type": "boolean" } }
      }
    },
    "false_alarm": {},
    "escape": {
      "type": ["object", "null"],
      "required": ["n", "escaped"],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "escaped": { "type": "integer", "minimum": 0 }
      }
    },
    "plants": {},
    "result": { "enum": ["pass", "fail", "not_run"] }
  }
}
