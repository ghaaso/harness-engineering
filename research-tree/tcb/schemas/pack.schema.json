{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pack",
  "description": "A pack (CONTRACT 3.3): staging pack.json, stored p_*. The id hashes content only; status lives outside it. index summaries are capped at threshold index_words by commit.mjs.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "field", "questions_sha", "cards", "conclusions", "not_covered"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "const": "pack" },
    "field": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])$)[a-z][a-z0-9]{0,11}$" },
    "questions_sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cards": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/card_id" } },
    "conclusions": { "type": "array", "items": { "$ref": "sentence.schema.json#/$defs/sentence" } },
    "index": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mechanism", "summary", "cards"],
        "properties": {
          "mechanism": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
          "summary": { "type": "string", "minLength": 1 },
          "cards": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/card_id" } }
        }
      }
    },
    "not_covered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "reason"],
        "properties": {
          "question_id": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,11}-[a-z0-9]{1,12}-[0-9]{2,3}$" },
          "reason": { "enum": ["no-source", "budget", "cut", "dropped-by-owner"] }
        }
      }
    },
    "parent": { "type": ["string", "null"], "pattern": "^p_[0-9a-f]{16}$" }
  },
  "$defs": {
    "card_id": { "type": "string", "pattern": "^c_[0-9a-f]{16}$" }
  }
}
