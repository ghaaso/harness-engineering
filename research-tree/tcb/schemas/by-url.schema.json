{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "by-url",
  "description": "One line of .snapshots/by-url/<urlKey>.jsonl (CONTRACT 3.13), appended by snap.mjs under the lock. reason is required when raw_sha is null (checked by snap.mjs and fsck, not expressible in this schema subset).",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "raw_sha", "retrieved_at", "source_changed"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "raw_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "retrieved_at": { "type": "string", "minLength": 1 },
    "source_changed": { "type": "boolean" },
    "reason": { "enum": ["http-error", "blocked", "too-large", "timeout", "pdf", "unsupported-type", "empty-text", "private-address", "bad-scheme", "too-many-redirects"] }
  }
}
