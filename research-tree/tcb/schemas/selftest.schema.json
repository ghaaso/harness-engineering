{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "selftest",
  "description": "run/selftest.json (CONTRACT 2.1 and 3.22, spec/selftest.mjs.md): cases sorted by script then case; n maps to the case root tmp/st-<nonce8>/<n>/.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tcb_sha", "ce", "ran_at", "result", "cases", "checks", "failed"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "tcb_sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ce": { "type": "integer", "minimum": 1 },
    "ran_at": { "type": "string", "minLength": 1 },
    "result": { "enum": ["pass", "fail", "not_run"] },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "script", "case", "kind", "fault_class", "expect_exit", "exit", "pass"],
        "properties": {
          "n": { "type": "integer", "minimum": 0 },
          "script": { "type": "string", "minLength": 1 },
          "case": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["good", "bad"] },
          "fault_class": { "type": "string" },
          "expect_exit": { "type": ["integer", "null"] },
          "exit": { "type": ["integer", "null"] },
          "pass": { "type": "boolean" },
          "why": { "type": "string" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "pass", "detail"],
        "properties": {
          "check": { "type": "string", "minLength": 1 },
          "pass": { "type": "boolean" },
          "detail": {}
        }
      }
    },
    "failed": { "type": "array", "items": { "type": "string" } }
  }
}
