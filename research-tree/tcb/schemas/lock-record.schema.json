{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lock-record",
  "description": "The record inside run/run.lock and run/watcher.lock (CONTRACT 3.10), written by lib.acquireLock with wx. start_time and acquired_at are null when unknown.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["pid", "start_time", "nonce", "script", "acquired_at"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "pid": { "type": "integer", "minimum": 0 },
    "start_time": { "type": ["string", "null"] },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "script": { "type": ["string", "null"] },
    "ce": { "type": ["integer", "null"], "minimum": 1 },
    "acquired_at": { "type": ["string", "null"] }
  }
}
