{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ready",
  "description": "wt/<task>-e<e>/staging/READY.json (CONTRACT 3.12), written by the session: untrusted. The briefs give it without schema_version, so the field is optional here (1 when present).",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "task", "epoch"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "enum": ["ready", "repair"] },
    "task": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:$|[.-]))[a-z][a-z0-9-]{1,39}$" },
    "epoch": { "type": "integer", "minimum": 1 },
    "step": { "enum": ["pack", "review", "stpa", "fmea", "hazards"] },
    "question_ids": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,11}-[a-z0-9]{1,12}-[0-9]{2,3}$" } },
    "missing": { "enum": ["source", "snapshot", "card", "check", "other"] }
  }
}
