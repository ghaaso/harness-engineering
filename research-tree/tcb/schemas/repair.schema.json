{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "repair",
  "description": "views/repair.json (CONTRACT 3.22, spec/tms.mjs.md), items sorted by node.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "label", "object", "causes"],
        "properties": {
          "node": { "type": "string", "minLength": 1 },
          "label": { "enum": ["STALE", "PENDING"] },
          "object": { "type": "string", "minLength": 1 },
          "causes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["card_id", "code"],
              "properties": {
                "card_id": { "type": "string" },
                "code": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
