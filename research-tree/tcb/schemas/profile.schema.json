{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "profile",
  "description": "tcb/profiles/<role>.json (CONTRACT 3.21; content owned by spec/guard-hook.mjs.md). Prefixes use the {root}, {attempt} and {batch} placeholders. guard-hook and audit enforce the same profile.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "tools_allow", "tools_deny", "read_prefixes", "write_prefixes", "agent_types", "fetch", "bash"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "tools_allow": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "tools_deny": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "read_prefixes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "write_prefixes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "agent_types": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" } },
    "fetch": { "enum": ["none", "witnessed", "any"] },
    "bash": { "enum": ["none", "tcb-node"] }
  }
}
