{
  "schema_version": 1,
  "role": "coordinator",
  "tools_allow": [
    "Read",
    "Glob",
    "Grep",
    "Write",
    "Edit",
    "Agent",
    "Bash",
    "PowerShell",
    "ToolSearch"
  ],
  "tools_deny": [
    "NotebookEdit",
    "MultiEdit",
    "WebSearch",
    "Task"
  ],
  "read_prefixes": [
    "{root}/run/status.json",
    "{root}/views/",
    "{root}/store/objects/x_",
    "{root}/completeness/gate.json",
    "{root}/plan/",
    "{root}/tcb/briefs/",
    "{root}/tcb/README.md"
  ],
  "write_prefixes": [
    "{root}/plan/questions/",
    "{root}/plan/approaches.json",
    "{root}/plan/protocols/",
    "{root}/plan/analysis-plan.json",
    "{root}/plan/cost-inputs.json",
    "{root}/plan/tasks-plan.json",
    "{root}/plan/plant-candidates/",
    "{root}/plan/our-work/",
    "{root}/plan/notes/"
  ],
  "agent_types": [
    "checker",
    "mapper"
  ],
  "fetch": "none",
  "bash": "tcb-node"
}
