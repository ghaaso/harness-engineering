{
  "schema_version": 1,
  "permission_patterns": ["synthetic permission denial"],
  "probes": [
    {"probe": "write-tcb", "actor": "main", "tool": "Write", "match": {"file_path": "canary-area/tcb/canary-x.txt"}, "expect": "refused", "layer": "hook"},
    {"probe": "bash-any", "actor": "main", "tool": "Bash", "match": {"command": "canary-bash-probe"}, "expect": "refused", "layer": "any"},
    {"probe": "write-control", "actor": "main", "tool": "Write", "match": {"file_path": "canary-area/staging/canary-control.txt"}, "expect": "allowed", "layer": "any"}
  ]
}
