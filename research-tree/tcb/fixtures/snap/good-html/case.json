{
  "schema_version": 1,
  "script": "snap",
  "kind": "good",
  "fault_class": "none",
  "args": ["--root", "{root}", "--ce", "1", "--url", "{server}/a.html", "--now", "2026-11-17T10:00:00.000Z"],
