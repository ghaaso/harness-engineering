{
  "about": "Invented texts for witness.mjs T6: number tokens. Every text is 'In the pilot the reported figure was <token> across all shops.' and the quote is the words before the token.",
  "template": "In the pilot the reported figure was {token} across all shops.",
  "quote": "the reported figure was",
  "cases": [
    { "name": "t6-thousands-comma-decimal-point", "token": "1,234.5", "value": 1234.5, "unit": "units", "expect": { "result": "witnessed", "reason": "ok", "number_bound": true, "number_at": "1,234.5" } },
    { "name": "t6-space-thousands-decimal-comma", "token": "1 234,5", "value": 1234.5, "unit": "units", "expect": { "result": "witnessed", "reason": "ok", "number_bound": true, "number_at": "1 234,5" } },
    { "name": "t6-plain", "token": "1234.5", "value": 1234.5, "unit": "units", "expect": { "result": "witnessed", "reason": "ok", "number_bound": true, "number_at": "1234.5" } },
    { "name": "t6-negative-ascii", "token": "-3", "value": -3, "unit": "points", "expect": { "result": "witnessed", "reason": "ok", "number_bound": true } },
    { "name": "t6-negative-minus-sign", "token": "−3", "value": -3, "unit": "points", "expect": { "result": "witnessed", "reason": "ok", "number_bound": true } },
    { "name": "t6-unsigned-token-for-negative-value", "token": "3", "value": -3, "unit": "points", "expect": { "result": "witnessed", "reason": "ok", "number_bound": true } },
    { "name": "t6-30-is-not-3", "token": "30", "value": 3, "unit": "points", "expect": { "result": "rejected", "reason": "number-missing" } },
    { "name": "t6-0.3-is-not-3", "token": "0.3", "value": 3, "unit": "points", "expect": { "result": "rejected", "reason": "number-missing" } },
    { "name": "t6-space-group-whole", "token": "3 100", "value": 3100, "unit": "units", "expect": { "result": "witnessed", "reason": "ok", "number_bound": true } },
    { "name": "t6-space-group-first-part", "token": "3 100", "value": 3, "unit": "units", "expect": { "result": "witnessed", "reason": "ok", "number_bound": true } },
    { "name": "t6-space-group-second-part", "token": "3 100", "value": 100, "unit": "units", "expect": { "result": "witnessed", "reason": "ok", "number_bound": true } },
    { "name": "t6-percent-word", "token": "12.5 percent", "value": 12.5, "unit": "%", "expect": { "result": "witnessed", "reason": "ok", "number_bound": true, "number_at": "12.5 percent" } },
    { "name": "t6-percent-sign", "token": "12.5%", "value": 12.5, "unit": "%", "expect": { "result": "witnessed", "reason": "ok", "number_bound": true, "number_at": "12.5%" } },
    { "name": "t6-comma-read-as-decimal", "token": "1,234", "value": 1.234, "unit": "units", "expect": { "result": "witnessed", "reason": "ok", "number_bound": true } },
    { "name": "t6-comma-read-as-thousands", "token": "1,234", "value": 1234, "unit": "units", "expect": { "result": "witnessed", "reason": "ok", "number_bound": true } },
    { "name": "t6-no-rounding-up", "token": "12.6", "value": 12.5, "unit": "units", "expect": { "result": "rejected", "reason": "number-missing" } },
    { "name": "t6-no-rounding-whole", "token": "13", "value": 12.5, "unit": "units", "expect": { "result": "rejected", "reason": "number-missing" } }
  ]
}
