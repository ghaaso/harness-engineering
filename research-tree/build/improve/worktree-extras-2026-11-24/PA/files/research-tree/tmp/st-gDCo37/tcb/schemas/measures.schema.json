{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "measures",
  "description": "views/measures.json (CONTRACT 3.22, spec/render.mjs.md steps 6-7). values is always present and read by gate.mjs for its action lines; readings are never a gate. Zero denominators give null.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "built_from", "generated_at", "weights", "by_task", "by_field", "by_arm", "totals", "seeded_escape_rate", "quality", "values", "readings"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "built_from": {},
    "generated_at": { "type": "string" },
    "weights": {},
    "by_task": { "type": "object" },
    "by_field": { "type": "object" },
    "by_arm": { "type": ["object", "null"] },
    "totals": { "type": "object" },
    "seeded_escape_rate": {},
    "quality": { "type": ["object", "null"] },
    "values": {
      "type": "object",
      "required": ["unverifiable_share", "coverage"],
      "properties": {
        "unverifiable_share": { "type": ["number", "null"] },
        "coverage": { "type": ["number", "null"] }
      }
    },
    "readings": { "type": "object" }
  }
}
