{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coverage",
  "description": "views/coverage.json (CONTRACT 3.22, spec/render.mjs.md step 5). Per-field figures (approved, covered, not_covered, heldout, Chapman, coverage, yield_per_reader_call, below_floor) are left open to render.mjs.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "built_from", "generated_at", "basis", "fields", "union"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "built_from": {},
    "generated_at": { "type": "string" },
    "basis": {},
    "fields": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "union": {
      "type": "object",
      "required": ["approved", "covered", "not_covered"],
      "properties": {
        "approved": { "type": "integer", "minimum": 0 },
        "covered": { "type": "integer", "minimum": 0 },
        "not_covered": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
