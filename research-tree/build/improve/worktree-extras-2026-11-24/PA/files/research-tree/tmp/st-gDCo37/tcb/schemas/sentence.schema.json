{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sentence",
  "description": "A sentence inside a pack (conclusions) or a review (sentences), CONTRACT 3.2. Other schemas use sentence.schema.json#/$defs/sentence.",
  "x-version": 1,
  "$ref": "#/$defs/sentence",
  "$defs": {
    "sid": { "type": "string", "pattern": "^s[0-9]{1,4}$" },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
    "card_id": { "type": "string", "pattern": "^c_[0-9a-f]{16}$" },
    "string_list": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": { "$ref": "#/$defs/string_list" },
        "model_family": { "$ref": "#/$defs/string_list" },
        "repo_size": { "type": ["string", "null"], "maxLength": 200 },
        "language": { "$ref": "#/$defs/string_list" },
        "metric": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sid", "approach_id", "measure", "kind", "text", "cites", "applies_to"],
      "properties": {
        "sid": { "$ref": "#/$defs/sid" },
        "approach_id": { "$ref": "#/$defs/slug" },
        "measure": { "$ref": "#/$defs/slug" },
        "kind": { "enum": ["fact", "judgment"] },
        "text": { "type": "string", "minLength": 1, "x-maxWords": 80 },
        "cites": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/card_id" } },
        "applies_to": { "$ref": "#/$defs/applies_to" }
      }
    }
  }
}
