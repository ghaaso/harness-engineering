{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "watcher",
  "description": "run/watcher.json (CONTRACT 3.10), written by watch.mjs. Counters are continued by any later watcher; a new epoch resets that task's counters. Per-task and parse-state entries are open objects (internal state of the watcher).",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ce", "pid", "start_time", "ticks_total", "last_tick_at", "active", "pending", "tasks"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "ce": { "type": "integer", "minimum": 1 },
    "pid": { "type": "integer", "minimum": 0 },
    "start_time": { "type": ["string", "null"] },
    "ticks_total": { "type": "integer", "minimum": 0 },
    "last_tick_at": { "type": ["string", "null"] },
    "intake": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["pid", "start_time"],
      "properties": {
        "pid": { "type": "integer", "minimum": 0 },
        "start_time": { "type": ["string", "null"] }
      }
    },
    "active": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "class", "first_tick"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "class": { "type": ["string", "integer"] },
          "task": { "type": ["string", "null"] },
          "first_tick": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "reraise": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
    "stuck": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "epoch": { "type": "integer", "minimum": 0 },
          "calls": { "type": "integer", "minimum": 0 },
          "stall_calls": { "type": "integer", "minimum": 0 },
          "hang_ticks": { "type": "integer", "minimum": 0 },
          "V": { "type": ["integer", "null"] },
          "V_min": { "type": ["integer", "null"] },
          "loop": { "type": ["object", "null"] },
          "spend": { "type": ["number", "null"] },
          "window": { "type": ["number", "null"] },
          "zombie_tokens": { "type": ["number", "null"] },
          "files": { "type": "object", "additionalProperties": { "$ref": "#/$defs/parse_state" } }
        }
      }
    },
    "coord_file": { "type": ["object", "null"], "additionalProperties": { "$ref": "#/$defs/parse_state" } }
  },
  "$defs": {
    "parse_state": {
      "type": "object",
      "properties": {
        "end_byte": { "type": "integer", "minimum": 0 },
        "last_call": { "type": ["object", "null"] },
        "calls": { "type": "integer", "minimum": 0 },
        "input": { "type": "number" },
        "cache_read": { "type": "number" },
        "cache_write": { "type": "number" },
        "output": { "type": "number" },
        "last_context": { "type": "number" },
        "peak_context": { "type": "number" },
        "loop": { "type": ["object", "null"] }
      }
    }
  }
}
