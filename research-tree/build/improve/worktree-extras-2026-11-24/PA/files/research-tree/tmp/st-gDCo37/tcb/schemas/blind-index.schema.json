{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "blind-index",
  "description": "views/blind/index.json (CONTRACT 3.22, spec/compare.mjs.md anon step 5), rebuilt each run.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items", "arm_names"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "items": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^b[1-9][0-9]*$" } },
    "arm_names": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
