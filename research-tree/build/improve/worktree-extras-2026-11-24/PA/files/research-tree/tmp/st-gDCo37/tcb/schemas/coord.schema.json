{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coord",
  "description": "run/coord.json (CONTRACT 3.9), written by handover.mjs: the coordinator epoch ce.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ce", "started_at", "tcb_commit"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "ce": { "type": "integer", "minimum": 1 },
    "session": { "type": ["string", "null"], "pattern": "^[0-9a-f-]{36}$" },
    "started_at": { "type": "string", "minLength": 1 },
    "tcb_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "successor_nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$", "description": "FX-CGATE: the bind nonce of the coordinator not yet bound at ce; removed by handover bind." }
  }
}
