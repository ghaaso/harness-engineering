{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "status",
  "description": "run/status.json (CONTRACT 3.8), written by status.mjs: a pure function of files except generated_at.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "ce", "rev", "ledger", "tcb_commit", "acked_seq", "events_pending", "slots", "memory", "budget", "halted", "draining", "tasks", "watcher", "alarm", "open_intents", "not_run", "anomalies"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "ce": { "type": ["integer", "null"], "minimum": 1 },
    "rev": { "type": ["integer", "null"], "minimum": 0 },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "head"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "head": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "tcb_commit": { "type": ["string", "null"] },
    "acked_seq": { "type": ["integer", "null"], "minimum": 0 },
    "events_pending": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live", "unknown", "unconfirmed", "max"],
      "properties": {
        "live": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "unconfirmed": { "type": "integer", "minimum": 0 },
        "max": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["free_mb", "reserve_mb", "peak_mb"],
      "properties": {
        "free_mb": { "type": ["number", "null"] },
        "reserve_mb": { "type": ["number", "null"] },
        "peak_mb": { "type": ["number", "null"] }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["B", "reservation", "r", "spent_total"],
      "properties": {
        "B": { "type": ["number", "null"] },
        "reservation": { "type": ["number", "null"] },
        "r": { "type": ["number", "null"] },
        "spent_total": { "type": ["number", "null"] }
      }
    },
    "halted": { "type": "boolean" },
    "draining": { "type": "boolean" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task", "state", "step", "epoch", "V", "spent", "e_task", "soft", "hard", "window", "next"],
        "properties": {
          "task": { "type": "string", "minLength": 1 },
          "state": { "enum": ["planned", "active", "parked", "committed", "cut", "failed", "dropped"] },
          "step": { "enum": ["none", "fenced", "stop-requested", "stopped", "admitted", "started", "bound"] },
          "epoch": { "type": "integer", "minimum": 0 },
          "V": { "type": ["integer", "null"], "minimum": 0 },
          "spent": { "type": ["number", "null"], "minimum": 0 },
          "e_task": { "type": ["number", "null"], "minimum": 0 },
          "soft": { "type": ["number", "null"] },
          "hard": { "type": ["number", "null"] },
          "window": { "type": ["number", "null"] },
          "next": { "type": "string", "pattern": "^(none|replace-fence|replace-start|stop-request|stop-session|stop-verify|start-session|bind|audit|commit|owner|replace-fence --reason (stall|hang|loop|crash|tainted|memory|handover|cut|drop)|replace-fence --reason crash --if-unclaimed|close-session [0-9a-f-]{36})$" },
          "route": { "$ref": "#/$defs/route" }
        }
      }
    },
    "helper_routes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/route" } },
    "watcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alive", "ce", "last_tick_at", "ticks_total"],
      "properties": {
        "alive": { "type": ["boolean", "null"] },
        "ce": { "type": ["integer", "null"] },
        "last_tick_at": { "type": ["string", "null"] },
        "ticks_total": { "type": "integer", "minimum": 0 }
      }
    },
    "alarm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alive", "ce"],
      "properties": {
        "alive": { "type": ["boolean", "null"] },
        "ce": { "type": ["integer", "null"] }
      }
    },
    "open_intents": { "type": "array", "items": { "type": "string" } },
    "not_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "subject"],
        "properties": {
          "check": { "type": "string", "minLength": 1 },
          "subject": { "type": ["string", "null"] }
        }
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "detail": {}
        }
      }
    }
  },
  "$defs": {
    "route": {
      "description": "FX-PILOT unit PA: the kind and model of a start, from tcb/tier-routes.json; null when the tier or type has no route.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "model"],
          "properties": { "kind": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 } }
        }
      ]
    }
  }
}
