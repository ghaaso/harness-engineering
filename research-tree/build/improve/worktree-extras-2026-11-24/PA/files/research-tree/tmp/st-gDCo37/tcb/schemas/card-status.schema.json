{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "card-status",
  "description": "One line of store/status/card_status.jsonl (CONTRACT 3.15), appended by promote.mjs only. The last line per card is its status; no line = pending.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "card_id", "card_sha", "status", "reason", "at"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "card_id": { "type": "string", "pattern": "^c_[0-9a-f]{16}$" },
    "card_sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["witnessed", "rejected", "unverifiable", "confirmed"] },
    "reason": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "witness_seq": { "type": ["integer", "null"], "minimum": 1 },
    "check": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["batch", "item", "verdict"],
      "properties": {
        "batch": { "type": "string", "pattern": "^b[0-9]+-[0-9]+$" },
        "item": { "type": "string", "pattern": "^i_[0-9a-f]{16}$" },
        "verdict": { "enum": ["confirmed", "number_mismatch", "baseline_swapped", "conditions_mismatch", "outside_conditions", "unclear"] },
        "node": { "type": ["string", "null"], "pattern": "^[pr]_[0-9a-f]{16}#s[0-9]{1,4}$" }
      }
    },
    "classes": { "type": "array", "uniqueItems": true, "items": { "enum": ["J1", "J2", "J3", "J4"] } },
    "at": { "type": "string", "minLength": 1 }
  }
}
