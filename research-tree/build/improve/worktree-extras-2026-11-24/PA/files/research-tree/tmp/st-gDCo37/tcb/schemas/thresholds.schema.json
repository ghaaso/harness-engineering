{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "thresholds",
  "description": "tcb/thresholds.json (CONTRACT 3.20). value null or gate false = a reading, never a gate (R45). line marks an owner action line that gate.mjs compares with views/measures.json values[measure].",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "params"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_]{0,63}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit", "source", "gate"],
          "properties": {
            "value": { "type": ["number", "string", "boolean", "null", "array", "object"] },
            "unit": { "type": "string" },
            "source": { "type": "string", "pattern": "^(mapping:.+|owner|guess|measured|coordinator)$" },
            "gate": { "type": "boolean" },
            "line": {
              "type": "object",
              "additionalProperties": false,
              "required": ["measure", "op"],
              "properties": {
                "measure": { "type": "string", "minLength": 1 },
                "op": { "enum": ["max", "min", "floor"] }
              }
            }
          }
        }
      }
    }
  }
}
