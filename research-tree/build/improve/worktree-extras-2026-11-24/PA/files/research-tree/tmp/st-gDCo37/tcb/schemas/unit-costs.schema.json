{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unit-costs",
  "description": "plan/unit-costs.json (CONTRACT 3.22, spec/cost.mjs.md step 9), written by cost from-transcripts. Counts are tokens, never money; the nested model figures are left open to cost.mjs.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "trusted", "unattributed_share", "missing", "no_estimate", "roles", "units", "t_q", "tokens_per_meter_pct", "meter_self_reported", "serial_fraction", "rss_mb"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "trusted": { "type": "boolean" },
    "unattributed_share": { "type": ["number", "null"] },
    "missing": {},
    "no_estimate": {},
    "roles": { "type": "object" },
    "units": { "type": "object" },
    "t_q": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["t", "k"],
        "properties": {
          "t": { "type": ["number", "null"] },
          "k": { "type": ["number", "null"] }
        }
      }
    },
    "tokens_per_meter_pct": {},
    "meter_self_reported": {},
    "serial_fraction": {},
    "rss_mb": {}
  }
}
