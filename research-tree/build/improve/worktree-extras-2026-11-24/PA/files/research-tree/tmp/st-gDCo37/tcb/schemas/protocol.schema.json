{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "protocol",
  "description": "plan/protocols/<field>.json and its frozen copy plan/frozen/protocol-<field>-<sha12>.json (CONTRACT 3.18). protocol-freeze.mjs adds the checks a schema cannot make.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "field", "question_ids", "criteria", "routes", "card_schema_version", "certainty_method", "sesoi", "outlist_vocab", "seeds", "must_read", "fixed_files", "cross_field", "approval"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "const": "protocol" },
    "field": { "$ref": "#/$defs/field" },
    "question_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/question_key" } },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": { "type": "array", "items": { "$ref": "#/$defs/criterion" } },
        "exclude": { "type": "array", "items": { "$ref": "#/$defs/criterion" } }
      }
    },
    "routes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["keyword", "backward", "forward", "contrary", "seed"] } },
    "card_schema_version": { "type": "integer", "minimum": 1 },
    "certainty_method": { "type": "string", "minLength": 1 },
    "sesoi": { "type": "object", "additionalProperties": false, "patternProperties": { "^[a-z][a-z0-9_]{0,47}$": { "type": "number" } } },
    "outlist_vocab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approaches", "measures", "effects"],
      "properties": {
        "approaches": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "measures": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "effects": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$" } }
      }
    },
    "seeds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "must_read": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "why"],
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "why": { "type": "string" }
        }
      }
    },
    "fixed_files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "cross_field": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "owner_field"],
        "properties": {
          "question_id": { "$ref": "#/$defs/question_key" },
          "owner_field": { "$ref": "#/$defs/field" }
        }
      }
    },
    "approval": { "$ref": "#/$defs/approval" }
  },
  "$defs": {
    "field": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])$)[a-z][a-z0-9]{0,11}$" },
    "question_key": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,11}-[a-z0-9]{1,12}-[0-9]{2,3}$" },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "text"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "at"],
      "properties": {
        "quote": { "type": "string", "minLength": 1, "maxLength": 500 },
        "at": { "type": "string", "minLength": 1 }
      }
    }
  }
}
