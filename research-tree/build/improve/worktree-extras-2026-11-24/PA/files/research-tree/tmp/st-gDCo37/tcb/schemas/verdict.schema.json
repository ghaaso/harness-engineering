{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verdict",
  "description": "A checker's verdict on one queue item (CONTRACT 3.17). lib.checkerVerdicts applies the same rule.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["item", "verdict"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "item": { "type": "string", "pattern": "^i_[0-9a-f]{16}$" },
    "verdict": { "enum": ["confirmed", "number_mismatch", "baseline_swapped", "conditions_mismatch", "outside_conditions", "unclear"] },
    "field": { "type": "string" },
    "offset": { "type": "integer", "minimum": 0 }
  }
}
