{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gate",
  "description": "completeness/gate.json (CONTRACT 3.19), written by gate.mjs. Admission accepts it only when result is pass and both shas equal lib.currentDesign's (R55). A sha is null on not_run when its input is absent.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cut_sha", "hazards_sha", "matrix", "p_ids_missing", "high_uncovered", "model", "action_lines", "result", "reasons"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "cut_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "hazards_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "model_result_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full", "empty_cells"],
      "properties": {
        "full": { "type": "boolean" },
        "empty_cells": { "type": "integer", "minimum": 0 }
      }
    },
    "p_ids_missing": { "type": "array", "items": { "type": "string" } },
    "high_uncovered": { "type": "array", "items": { "type": "string" } },
    "model": { "enum": ["pass", "fail", "not_run"] },
    "action_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["measure", "line", "result"],
        "properties": {
          "measure": { "type": "string", "minLength": 1 },
          "line": {},
          "value": { "type": ["number", "null"] },
          "result": { "enum": ["pass", "fail", "reading"] }
        }
      }
    },
    "result": { "enum": ["pass", "fail", "not_run"] },
    "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
