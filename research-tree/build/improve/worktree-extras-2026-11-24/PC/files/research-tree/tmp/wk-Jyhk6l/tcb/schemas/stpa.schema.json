{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stpa",
  "description": "STPA output of a design-check task (CONTRACT 3.4, spec/gate.mjs.md). Stored by commit.mjs as a d_ object.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "cut_sha", "controllers", "ucas"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "const": "stpa" },
    "cut_sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "controllers": { "type": "array", "items": { "$ref": "#/$defs/controller" } },
    "ucas": { "type": "array", "items": { "$ref": "#/$defs/uca" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,31}$" },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "actions", "feedback"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "x-maxWords": 8 },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "target"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "target": { "$ref": "#/$defs/id" }
            }
          }
        },
        "feedback": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "from"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "from": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "uca": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uca_id", "action_id", "type", "hazardous", "context", "case"],
      "properties": {
        "uca_id": { "$ref": "#/$defs/id" },
        "action_id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["N", "U", "T", "D"] },
        "hazardous": { "type": "boolean" },
        "context": { "type": "string", "x-maxWords": 40 },
        "case": { "type": "string", "x-maxWords": 40 }
      }
    }
  }
}
