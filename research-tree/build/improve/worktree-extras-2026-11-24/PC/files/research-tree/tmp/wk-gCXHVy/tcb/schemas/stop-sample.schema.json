{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stop-sample",
  "description": "run/stop-sample/<task>-e<e>.json (CONTRACT 3.22), written by stop verify: transcript sizes in bytes keyed by the path relative to transcripts_root.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "epoch", "target", "tick", "sizes"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "task": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:$|[.-]))[a-z][a-z0-9-]{1,39}$" },
    "epoch": { "type": "integer", "minimum": 1 },
    "target": { "type": ["integer", "string"] },
    "tick": { "type": "integer", "minimum": 0 },
    "at": { "type": "string", "minLength": 1, "description": "FX-CLOSE (c): the wall time of the sample (the verify's now); a sample without it is taken again" },
    "sizes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
  }
}
