{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tasks-plan",
  "description": "plan/tasks-plan.json (CONTRACT 3.22), the coordinator's draft; replace plan validates it (deps name planned tasks, no cycle) and creates rows. approval is not checked by replace.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tasks"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task", "stage", "role", "tier", "steps", "deps", "question_ids", "e_task"],
        "properties": {
          "task": { "$ref": "#/$defs/task" },
          "field": { "type": ["string", "null"], "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])$)[a-z][a-z0-9]{0,11}$" },
          "stage": { "enum": ["research", "review", "fresh-review", "control", "design-check"] },
          "role": { "enum": ["child", "child-reviewing", "fresh-reviewer", "control", "stpa", "fmea", "mapper", "canary"] },
          "tier": { "type": "string", "minLength": 1 },
          "steps": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["pack", "review", "stpa", "fmea", "hazards"] } },
          "deps": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/task" } },
          "question_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,11}-[a-z0-9]{1,12}-[0-9]{2,3}$" } },
          "e_task": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "at"],
      "properties": {
        "quote": { "type": "string", "minLength": 1, "maxLength": 500 },
        "at": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "task": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:$|[.-]))[a-z][a-z0-9-]{1,39}$" }
  }
}
