{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "labels",
  "description": "views/labels.json (CONTRACT 3.22, spec/tms.mjs.md). No timestamp, so equal inputs give equal bytes.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inputs", "cards", "nodes", "verdicts", "dismissals", "certificates", "targets"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status_seq", "objects", "commits", "flags"],
      "properties": {
        "status_seq": { "type": ["integer", "null"] },
        "objects": {},
        "commits": {},
        "flags": {}
      }
    },
    "cards": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^c_[0-9a-f]{16}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "status_seq"],
          "properties": {
            "label": { "enum": ["pending", "witnessed", "confirmed", "unverifiable", "rejected", "superseded"] },
            "status_seq": { "type": ["integer", "null"] }
          }
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "why", "causes"],
        "properties": {
          "label": { "enum": ["STALE", "PENDING", "JUDGMENT", "IN"] },
          "why": { "type": "array", "items": { "type": "string" } },
          "causes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "verdicts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["label", "why"],
        "properties": { "label": { "type": "string" }, "why": {} }
      }
    },
    "dismissals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "why", "matched"],
        "properties": {
          "label": { "enum": ["standing", "untested", "reopened"] },
          "why": {},
          "matched": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "certificates": {
      "type": "object",
      "additionalProperties": { "enum": ["VALID", "STALE"] }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commit", "ok", "bad"],
        "properties": {
          "commit": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}\\.(pack|review|stpa|fmea|hazards)$" },
          "ok": { "type": "boolean" },
          "bad": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
