{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixture-case",
  "description": "tcb/fixtures/<script>/<case>/case.json (CONTRACT 3.22, spec/selftest.mjs.md). Placeholders in args: {root}, {server}. A good case expects exit 0; a bad case a non-zero exit (selftest checks the pairing). thresholds overrides tcb/thresholds.json values by name.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "script", "kind", "fault_class", "args", "expect"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "script": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "kind": { "enum": ["good", "bad"] },
    "fault_class": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "args": { "type": "array", "items": { "type": "string" } },
    "stdin": { "type": "string", "minLength": 1 },
    "serve": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^/": { "type": "string", "minLength": 1 } }
    },
    "thresholds": { "type": "object" },
    "git": { "type": "boolean", "description": "Build extension (e2e-fix stage): true makes the case root a git repository whose one commit holds its tcb/, and sets run/coord.json tcb_commit to that commit (needed by fsck's tcb check). Not yet in CONTRACT 3.22 or spec/selftest.mjs.md." },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit"],
      "properties": {
        "exit": { "type": "integer", "minimum": 0, "maximum": 255 },
        "code": { "type": "string", "minLength": 1 },
        "result": { "type": "object" },
        "stdout_empty": { "type": "boolean" },
        "stderr_prefix": { "type": "string" },
        "files": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^(absent|present|[0-9a-f]{64})$" }
        }
      }
    }
  }
}
