{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plant-key",
  "description": "sealed/plants/<task>.json (CONTRACT 3.17), written by seed.mjs plant. file is relative to plan/our-work/; locator is 'line <n>' (1-based).",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "k", "plants"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "task": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:$|[.-]))[a-z][a-z0-9-]{1,39}$" },
    "k": { "type": "integer", "minimum": 0 },
    "plants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plant_id", "file", "locator", "card_id", "against_hope", "original_sha", "planted_sha"],
        "properties": {
          "plant_id": { "type": "string", "pattern": "^pl_[0-9a-f]{16}$" },
          "file": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "pattern": "^line [1-9][0-9]*$" },
          "card_id": { "type": "string", "pattern": "^c_[0-9a-f]{16}$" },
          "against_hope": { "type": "boolean" },
          "original_sha": { "$ref": "#/$defs/sha" },
          "planted_sha": { "$ref": "#/$defs/sha" }
        }
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
