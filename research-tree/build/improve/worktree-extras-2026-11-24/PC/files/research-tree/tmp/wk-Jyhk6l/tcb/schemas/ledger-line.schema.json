{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ledger-line",
  "description": "One line of run/ledger.jsonl (CONTRACT 3.7): hash = sha256hex(prev + canonical(line without hash)); the first line's prev is 64 zeros. The per-kind data shapes are listed in the contract's table.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "prev", "hash", "ts", "writer", "writer_sha", "kind", "data"],
  "properties": {
    "seq": { "type": "integer", "minimum": 1 },
    "prev": { "$ref": "#/$defs/sha" },
    "hash": { "$ref": "#/$defs/sha" },
    "ts": { "type": "string", "minLength": 1 },
    "ce": { "type": ["integer", "null"], "minimum": 1 },
    "writer": { "type": "string", "minLength": 1 },
    "writer_sha": { "$ref": "#/$defs/sha" },
    "kind": {
      "enum": [
        "plan", "fence", "stop-request", "stop", "admit", "bind", "started", "intake", "commit",
        "zombie-write", "event", "drain", "halt", "overflow", "check", "witness", "promote", "audit",
        "fsck", "selftest", "protocol-freeze", "protocol-amend", "plan-freeze", "seed-split", "queue",
        "certificate", "cut", "gate", "unit-costs", "coord-init", "ce-raise", "coord-bind", "owner",
        "intent-open", "intent-done", "meter", "lock-break", "torn-tail", "incident"
      ]
    },
    "task": { "type": ["string", "null"], "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:$|[.-]))[a-z][a-z0-9-]{1,39}$" },
    "epoch": { "type": ["integer", "null"], "minimum": 0 },
    "data": { "type": "object" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
