{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "comparison",
  "description": "views/comparison.json (CONTRACT 3.22, spec/compare.mjs.md score step 4). comparison1, comparison2, blinding and prediction are left open to compare.mjs.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_sha256", "label", "plan_amended", "field", "n_questions", "arms", "comparison1", "comparison2", "blinding", "prediction", "reasons"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "label": { "type": "string" },
    "plan_amended": { "type": "integer", "minimum": 0 },
    "field": { "type": ["string", "null"] },
    "n_questions": { "type": "integer", "minimum": 0 },
    "arms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string" },
          "answered": {},
          "Y": { "type": "object", "additionalProperties": { "enum": [0, 1] } },
          "citation_failures": {},
          "outside_conditions": {},
          "judgment_share": {},
          "plants": {},
          "u": {},
          "tokens": {},
          "time": {},
          "rubric_total": {}
        }
      }
    },
    "comparison1": {},
    "comparison2": {},
    "blinding": {},
    "prediction": {},
    "reasons": { "type": "array", "items": { "type": "string" } }
  }
}
