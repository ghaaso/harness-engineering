{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plant-candidates",
  "description": "plan/plant-candidates/<field>.json (CONTRACT 3.22), coordinator-drafted and owner-approved; file is relative to plan/our-work/.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "field", "candidates"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "field": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])$)[a-z][a-z0-9]{0,11}$" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "file", "find", "replace", "card_id", "against_hope", "reason"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 64 },
          "file": { "type": "string", "minLength": 1 },
          "find": { "type": "string", "minLength": 1 },
          "replace": { "type": "string" },
          "card_id": { "type": "string", "pattern": "^c_[0-9a-f]{16}$" },
          "against_hope": { "type": "boolean" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
