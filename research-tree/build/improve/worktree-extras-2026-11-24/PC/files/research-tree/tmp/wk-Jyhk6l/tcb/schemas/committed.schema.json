{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "committed",
  "description": "wt/<task>-e<e>/view/committed.json (CONTRACT 3.22), written by commit intake: every accepted object, so a session can cite ids it cannot hash.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "epoch", "committed"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "task": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:$|[.-]))[a-z][a-z0-9-]{1,39}$" },
    "epoch": { "type": "integer", "minimum": 1 },
    "committed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "file"],
        "properties": {
          "id": { "type": "string", "pattern": "^[cprd]_[0-9a-f]{16}$" },
          "kind": { "enum": ["card", "pack", "review", "stpa", "fmea", "hazards"] },
          "file": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
