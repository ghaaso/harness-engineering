{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "commit-record",
  "description": "store/commits/<task>.<step>.json (CONTRACT 3.11), created once by commit.mjs; outputs_sha = sha256hex(canonical(outputs)).",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "step", "epoch", "step_key", "outputs", "outputs_sha"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "task": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:$|[.-]))[a-z][a-z0-9-]{1,39}$" },
    "step": { "enum": ["pack", "review", "stpa", "fmea", "hazards"] },
    "epoch": { "type": "integer", "minimum": 1 },
    "step_key": { "$ref": "#/$defs/sha" },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[cprd]_[0-9a-f]{16}$" },
          "kind": { "enum": ["card", "pack", "review", "stpa", "fmea", "hazards"] },
          "sha256": { "$ref": "#/$defs/sha" }
        }
      }
    },
    "outputs_sha": { "$ref": "#/$defs/sha" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
