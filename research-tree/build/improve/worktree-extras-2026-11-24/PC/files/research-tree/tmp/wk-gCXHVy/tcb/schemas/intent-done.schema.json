{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intent-done",
  "description": "run/intents/<key>.done (CONTRACT 3.9), written by status.mjs intent done (exclusive create).",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key", "done_at"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "key": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])$)[a-z0-9][a-z0-9-]{0,63}$" },
    "done_at": { "type": "string", "minLength": 1 }
  }
}
