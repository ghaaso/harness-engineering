{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "queue-item",
  "description": "queue/<batch>/item-<item_id>.json (CONTRACT 3.17), written by check-queue: the card's fields (no id), a window of snapshot text, and for a sentence item the sentence.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["item", "card", "window"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "item": { "type": "string", "pattern": "^i_[0-9a-f]{16}$" },
    "card": { "$ref": "card.schema.json" },
    "window": { "type": "string" },
    "sentence": { "$ref": "sentence.schema.json#/$defs/sentence" }
  }
}
