{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "heldout",
  "description": "sealed/heldout/<field>.json (CONTRACT 3.22, spec/protocol-freeze.mjs.md), written once at freeze by exclusive create; heldout is a sorted list of canonical ids.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "field", "protocol_sha256", "rng_seed", "seeds_sha256", "heldout"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "field": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])$)[a-z][a-z0-9]{0,11}$" },
    "protocol_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rng_seed": { "type": "string", "minLength": 1 },
    "seeds_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "heldout": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
