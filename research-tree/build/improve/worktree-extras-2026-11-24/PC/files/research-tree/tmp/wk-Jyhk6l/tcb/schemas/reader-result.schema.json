{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reader-result",
  "description": "A reader helper's structured result (CONTRACT 3.22): full cards (schema_version included) and the URLs skipped. harvest reads it and adds nothing to a card.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cards", "skipped"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "cards": { "type": "array", "items": { "$ref": "card.schema.json" } },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "reason"],
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "reason": { "enum": ["no-exact-words", "blocked", "other"] }
        }
      }
    }
  }
}
