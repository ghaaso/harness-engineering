{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "must-read",
  "description": "wt/<task>-e<e>/in/must_read.json (CONTRACT 3.22), built by replace start from the frozen protocol's must_read; guard-hook reads only this file plus the URL's by-url file and meta.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "urls"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "urls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "href"],
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "href": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
