{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intent",
  "description": "run/intents/<key>.json (CONTRACT 3.9), written by status.mjs intent open (exclusive create). The .done file is intent-done.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key", "ce", "subject", "text_sha", "created_at"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "key": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])$)[a-z0-9][a-z0-9-]{0,63}$" },
    "ce": { "type": "integer", "minimum": 1 },
    "subject": { "type": "string" },
    "text_sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
