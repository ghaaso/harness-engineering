{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rejected",
  "description": "wt/<task>-e<e>/view/rejected.json (CONTRACT 3.22), written by commit intake; file is the posix path relative to the attempt folder.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "epoch", "rejected"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "task": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:$|[.-]))[a-z][a-z0-9-]{1,39}$" },
    "epoch": { "type": "integer", "minimum": 1 },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "code"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "code": {
            "enum": [
              "unparseable", "schema-version", "schema-invalid", "unknown-kind", "name-kind", "wrong-field",
              "question-not-owned", "questions-sha", "supersede-reason", "supersedes-missing",
              "url-not-in-transcript", "not-sorted", "fk-card", "fk-parent", "fk-pack", "index-invalid",
              "dup-sid", "uncited-fact", "cite-outside-pack", "bad-sid", "untrusted-path"
            ]
          }
        }
      }
    }
  }
}
