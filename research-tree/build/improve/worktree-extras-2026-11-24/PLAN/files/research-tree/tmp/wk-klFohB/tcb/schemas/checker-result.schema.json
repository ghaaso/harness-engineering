{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "checker-result",
  "description": "A checker helper's structured result (CONTRACT 3.22); promote and seed extract verdicts with lib.checkerVerdicts.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdicts"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "verdicts": { "type": "array", "items": { "$ref": "verdict.schema.json" } }
  }
}
