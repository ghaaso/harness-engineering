{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scorer-result",
  "description": "The blind scorer's structured result (spec/compare.mjs.md): four rubric scores 0-4 and a guessed arm per blinded item b1..bn.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["scores"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "rubric", "guess_arm"],
        "properties": {
          "item": { "type": "string", "pattern": "^b[1-9][0-9]*$" },
          "rubric": {
            "type": "object",
            "additionalProperties": false,
            "required": ["specificity", "support", "scope", "calibration"],
            "properties": {
              "specificity": { "$ref": "#/$defs/score" },
              "support": { "$ref": "#/$defs/score" },
              "scope": { "$ref": "#/$defs/score" },
              "calibration": { "$ref": "#/$defs/score" }
            }
          },
          "guess_arm": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "score": { "type": "integer", "minimum": 0, "maximum": 4 }
  }
}
