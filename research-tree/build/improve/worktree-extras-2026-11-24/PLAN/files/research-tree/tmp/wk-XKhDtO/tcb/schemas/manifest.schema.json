{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest",
  "description": "An attempt's manifest (CONTRACT 3.5), store/objects/m_*, written by replace at start. The step key is the full sha256 of its canonical bytes.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "task", "epoch", "role", "brief_sha", "schema_shas", "tier", "tools", "inputs", "agents", "user_files", "outputs"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "const": "manifest" },
    "task": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:$|[.-]))[a-z][a-z0-9-]{1,39}$" },
    "epoch": { "type": "integer", "minimum": 1 },
    "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "brief_sha": { "$ref": "#/$defs/sha" },
    "schema_shas": { "type": "object", "additionalProperties": { "$ref": "#/$defs/sha" } },
    "tier": { "type": "string", "minLength": 1 },
    "tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha" }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "sha256"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha" }
        }
      }
    },
    "user_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "kinds"],
        "properties": {
          "step": { "enum": ["pack", "review", "stpa", "fmea", "hazards"] },
          "kinds": { "type": "array", "minItems": 1, "items": { "enum": ["card", "pack", "review", "stpa", "fmea", "hazards"] } }
        }
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
