{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "snapshot-meta",
  "description": ".snapshots/meta/<raw_sha>.json (CONTRACT 3.13), written by snap.mjs: describes the first retrieval of those bytes.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["url", "final_url", "retrieved_at", "http_status", "content_type", "bytes", "raw_sha"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "url": { "type": "string", "minLength": 1 },
    "final_url": { "type": ["string", "null"] },
    "retrieved_at": { "type": "string", "minLength": 1 },
    "http_status": { "type": ["integer", "null"] },
    "content_type": { "type": ["string", "null"] },
    "bytes": { "type": "integer", "minimum": 0 },
    "raw_sha": { "$ref": "#/$defs/sha" },
    "text_sha": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
    "extractor": { "enum": ["html-v1", null] },
    "reason": { "$ref": "#/$defs/reason" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reason": { "enum": ["http-error", "blocked", "too-large", "timeout", "pdf", "unsupported-type", "empty-text", "private-address", "bad-scheme", "too-many-redirects"] }
  }
}
