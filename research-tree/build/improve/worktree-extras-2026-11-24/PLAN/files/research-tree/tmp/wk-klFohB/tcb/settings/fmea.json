{
  "permissions": {
    "allow": [
      "Read(//{attempt}/**)",
      "Write(//{attempt}/staging/**)"
    ],
    "deny": [
      "Bash",
      "PowerShell",
      "NotebookEdit",
      "MultiEdit",
      "WebSearch",
      "Task",
      "WebFetch",
      "Agent",
      "Edit(//{root}/tcb/**)",
      "Write(//{root}/tcb/**)",
      "Edit(//{root}/run/**)",
      "Write(//{root}/run/**)",
      "Edit(//{root}/store/**)",
      "Write(//{root}/store/**)",
      "Edit(//{root}/sealed/**)",
      "Write(//{root}/sealed/**)",
      "Edit(//{root}/review-in/**)",
      "Write(//{root}/review-in/**)",
      "Edit(//{root}/.git/**)",
      "Write(//{root}/.git/**)",
      "Edit(//{attempt}/.claude/**)",
      "Write(//{attempt}/.claude/**)",
      "Edit(//{attempt}/staging/harvested/**)",
      "Write(//{attempt}/staging/harvested/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"{node}\" \"{root}/tcb/guard-hook.mjs\" --root \"{root}\" --role fmea --task {task} --epoch {epoch}",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
