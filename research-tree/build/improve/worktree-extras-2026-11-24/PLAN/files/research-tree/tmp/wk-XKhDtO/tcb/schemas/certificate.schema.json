{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "certificate",
  "description": "A certificate (CONTRACT 3.16), store/objects/x_*, written by certify.mjs. read_set_sha = sha256hex(canonicalize(read_set)); void once the recomputed hash differs.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "task", "subject", "pack", "step_key", "read_set", "read_set_sha", "session_label", "coverage", "cited", "plants", "result", "reasons"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "const": "certificate" },
    "task": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:$|[.-]))[a-z][a-z0-9-]{1,39}$" },
    "subject": { "type": "string", "pattern": "^r_[0-9a-f]{16}$" },
    "pack": { "type": "string", "pattern": "^p_[0-9a-f]{16}$" },
    "step_key": { "$ref": "#/$defs/sha" },
    "read_set": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["card_id", "status_seq"],
        "properties": {
          "card_id": { "type": "string", "pattern": "^c_[0-9a-f]{16}$" },
          "status_seq": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "read_set_sha": { "$ref": "#/$defs/sha" },
    "session_label": { "enum": ["clean", "tainted", null] },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "covered", "not_covered"],
      "properties": {
        "approved": { "type": "integer", "minimum": 0 },
        "covered": { "type": "integer", "minimum": 0 },
        "not_covered": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cited": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "confirmed", "failing"],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "confirmed": { "type": "integer", "minimum": 0 },
        "failing": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["card_id", "code"],
            "properties": {
              "card_id": { "type": "string" },
              "code": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "plants": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["k", "found", "contra_found"],
      "properties": {
        "k": { "type": ["integer", "null"], "minimum": 0 },
        "found": { "type": ["integer", "null"], "minimum": 0 },
        "contra_found": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "seed_escape": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["n", "escaped"],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "escaped": { "type": "integer", "minimum": 0 }
      }
    },
    "result": { "enum": ["certified", "not_certified", "not_run"] },
    "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
