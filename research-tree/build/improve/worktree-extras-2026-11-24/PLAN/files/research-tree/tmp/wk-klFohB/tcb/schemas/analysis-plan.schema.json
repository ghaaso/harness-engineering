{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analysis-plan",
  "description": "plan/analysis-plan.json and its frozen copy (CONTRACT 3.18). arm_tasks keys lie within arm_budget's and each reference names '<task>.<step>' (checked by protocol-freeze, arm-tasks). units, primary, delta, decision_rules and labels are left open: their content is the coordinator's.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "units", "primary", "secondary", "delta", "decision_rules", "looks", "arm_budget", "arm_tasks", "predicted_total", "labels", "approval"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "const": "analysis-plan" },
    "units": {},
    "primary": {},
    "secondary": { "type": "array" },
    "delta": {},
    "decision_rules": { "type": "array" },
    "looks": { "const": 1 },
    "arm_budget": { "type": "object", "additionalProperties": { "type": ["number", "null"], "minimum": 0 } },
    "arm_tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pack": { "$ref": "#/$defs/task_step" },
          "review": { "$ref": "#/$defs/task_step" }
        }
      }
    },
    "predicted_total": { "type": ["number", "null"] },
    "labels": { "type": "array" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "at"],
      "properties": {
        "quote": { "type": "string", "minLength": 1, "maxLength": 500 },
        "at": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "task_step": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}\\.(pack|review|stpa|fmea|hazards)$" }
  }
}
