{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "queue-batch",
  "description": "queue/<batch>/batch.json (CONTRACT 3.17), written last by check-queue.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["batch", "mode", "items"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "batch": { "type": "string", "pattern": "^b[0-9]+-[0-9]+$" },
    "mode": { "enum": ["intake", "freeze", "post-review"] },
    "items": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^i_[0-9a-f]{16}$" } }
  }
}
