{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "todo",
  "description": "wt/<task>-e<e>/view/todo.json (CONTRACT 3.22), written by replace start from lib.variant.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "epoch", "todo", "covered"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "task": { "type": "string", "pattern": "^(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:$|[.-]))[a-z][a-z0-9-]{1,39}$" },
    "epoch": { "type": "integer", "minimum": 1 },
    "todo": { "type": "array", "items": { "$ref": "#/$defs/question_key" } },
    "covered": { "type": "array", "items": { "$ref": "#/$defs/question_key" } }
  },
  "$defs": {
    "question_key": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,11}-[a-z0-9]{1,12}-[0-9]{2,3}$" }
  }
}
