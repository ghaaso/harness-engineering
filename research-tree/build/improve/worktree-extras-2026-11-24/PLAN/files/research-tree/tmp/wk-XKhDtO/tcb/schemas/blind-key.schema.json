{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "blind-key",
  "description": "sealed/blind/<plan-sha12>.json (CONTRACT 3.22, spec/compare.mjs.md anon step 5), exclusive create; maps each blinded item to exactly one arm.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_sha256", "rng_seed", "items"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rng_seed": { "type": "string", "minLength": 1 },
    "items": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^b[1-9][0-9]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arm"],
          "properties": { "arm": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
