{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "witness",
  "description": "One line of store/witness.jsonl (CONTRACT 3.14), appended by witness.mjs under the lock.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "card_id", "card_sha", "result", "number_bound", "reason", "source_changed", "w", "at"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "card_id": { "type": "string", "pattern": "^c_[0-9a-f]{16}$" },
    "card_sha": { "$ref": "#/$defs/sha" },
    "raw_sha": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
    "text_sha": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
    "result": { "enum": ["witnessed", "rejected", "unverifiable"] },
    "quote_offset": { "type": ["integer", "null"], "minimum": 0 },
    "number_offset": { "type": ["integer", "null"], "minimum": 0 },
    "number_bound": { "type": "boolean" },
    "reason": { "enum": ["ok", "quote-missing", "number-missing", "number-without-quote", "no-snapshot", "pdf", "empty-text", "card-changed"] },
    "source_changed": { "type": "boolean" },
    "w": { "type": "integer", "minimum": 0 },
    "at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
