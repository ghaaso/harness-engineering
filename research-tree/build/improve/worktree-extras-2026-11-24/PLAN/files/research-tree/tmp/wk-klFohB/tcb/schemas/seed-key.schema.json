{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "seed-key",
  "description": "sealed/seeds/<batch>.json (CONTRACT 3.17), written by check-queue through seed.mjs. At most one seed per class per batch (R42).",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["batch", "rng_seed", "items"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "batch": { "type": "string", "pattern": "^b[0-9]+-[0-9]+$" },
    "rng_seed": { "type": "string" },
    "items": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^i_[0-9a-f]{16}$": { "anyOf": [{ "$ref": "#/$defs/real" }, { "$ref": "#/$defs/seed" }] }
      }
    }
  },
  "$defs": {
    "real": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "card_id"],
      "properties": {
        "seed": { "const": false },
        "card_id": { "type": "string", "pattern": "^c_[0-9a-f]{16}$" },
        "node": { "type": ["string", "null"], "pattern": "^[pr]_[0-9a-f]{16}#s[0-9]{1,4}$" }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "class", "operator", "from_card", "seed_id"],
      "properties": {
        "seed": { "const": true },
        "class": { "enum": ["S1", "S2", "S3", "S4", "J1", "J2", "J3", "J4"] },
        "operator": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "from_card": { "type": "string", "pattern": "^c_[0-9a-f]{16}$" },
        "seed_id": { "type": "string", "pattern": "^s_[0-9a-f]{16}$" }
      }
    }
  }
}
