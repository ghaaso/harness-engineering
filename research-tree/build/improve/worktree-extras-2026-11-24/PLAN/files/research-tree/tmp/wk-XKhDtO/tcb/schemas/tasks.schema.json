{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tasks",
  "description": "run/tasks.json (CONTRACT 3.6): the task table, written only through lib.writeTasks (CAS on rev).",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rev", "tasks"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "rev": { "type": "integer", "minimum": 0 },
    "tasks": { "type": "array", "items": { "$ref": "task-row.schema.json#/$defs/row" } }
  }
}
