#!/bin/sh
# Runs the commit check that sits beside this folder (../check-commit.mjs). Wired by: git config core.hooksPath
# <absolute path of tools/git-hooks>. Then every worktree of the repository runs the main checkout's copy, and the
# check reads the index and manifests of the worktree being committed (git runs a hook at that worktree's top).
# With a relative core.hooksPath a worktree would look for its own copy, and one cut from an old base has none.
# The migration gate (2026-11-24, .claude/hooks/migration-gate.mjs): a commit whose staged files touch
# docs/program/monitor/round9/rust or round9/migration, once rust/Cargo.toml exists, is refused while
# checks/run.mjs --level <its level> fails; any other commit passes it at once.
g="$(dirname "$0")/../../.claude/hooks/migration-gate.mjs"
if [ -f "$g" ]; then node "$g" --gate || exit 1; fi
exec node "$(dirname "$0")/../check-commit.mjs"
