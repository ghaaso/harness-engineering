{
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "skillListingMaxDescChars": 1,
  "skillOverrides": {
    "android-background-execution": "off",
    "android-field-debugging": "off",
    "appsec-review-asvs": "off",
    "eas-expo-release": "off",
    "fastapi-alembic-safety": "off",
    "fixflow-orchestration": "off",
    "fixflow-repo-conventions": "off",
    "maestro-device-e2e": "off",
    "odoo-accounting-import": "off",
    "offline-sync-review": "off",
    "pakistan-accounting-context": "off",
    "selfhost-homelab-ops": "off",
    "supabase-railway-r2-recovery": "off"
  },
  "permissions": {
    "deny": [
      "Agent(fixflow-android-background-analyst)",
      "Agent(fixflow-appsec-reviewer)",
      "Agent(fixflow-device-debugger)",
      "Agent(fixflow-device-smoke-runner)",
      "Agent(fixflow-eas-release-operator)",
      "Agent(fixflow-explorer)",
      "Agent(fixflow-migration-reviewer)",
      "Agent(fixflow-odoo-analyst)",
      "Agent(fixflow-offline-sync-reviewer)",
      "Agent(fixflow-pr-reviewer)",
      "Agent(fixflow-recovery-operator)",
      "Agent(fixflow-selfhost-architect)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/library-start.mjs\"" } ] },
      { "matcher": "compact", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/migration-gate.mjs\"" } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/window-ceiling.mjs\"" } ] },
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/tier-hook.mjs\"" } ] },
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit|AskUserQuestion|Bash|PowerShell", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/record-guard.mjs\"" } ] },
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit|AskUserQuestion|Bash|PowerShell", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/owner-guard.mjs\"" } ] },
      { "matcher": "Agent|Task|SendMessage", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/plan-gate.mjs\"" } ] },
      { "matcher": "Agent|Task|SendMessage", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/count-gate.mjs\"" } ] },
      { "matcher": "Agent|Task", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/fanout-gate.mjs\"" } ] },
      { "matcher": "Agent|Task", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/creep-gate.mjs\"" } ] },
      { "matcher": "mcp__ccd_turn__wrap_up|Artifact", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/owner-report.mjs\"" } ] },
      { "matcher": "Agent|Task|mcp__ccd_session__start_session|Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/migration-gate.mjs\"" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/owner-report.mjs\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|PowerShell", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/journal-watch.mjs\"" } ] },
      { "matcher": "mcp__ccd_turn__wrap_up", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/owner-report.mjs\"" } ] },
      { "matcher": "Agent|Task|SendMessage", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/plan-gate.mjs\"" } ] },
      { "matcher": "Bash|PowerShell", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/migration-gate.mjs\"" } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/plan-gate.mjs\"" } ] },
      { "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/migration-gate.mjs\"" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/plan-gate.mjs\"" } ] }
    ]
  }
}
