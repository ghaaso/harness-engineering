recovered/
artifacts/
node_modules/
__pycache__/
*.pyc
.venv/
.env
.env.*
*.pem
*.key


# Per-machine settings and hook logs (harness-kit/setup.mjs writes the first).
.claude/settings.local.json
.claude/logs/
