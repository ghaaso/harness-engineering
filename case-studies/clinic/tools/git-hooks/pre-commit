#!/bin/sh
# Local workflow verification only; no clinic application or remote effects.
set -eu
workflow_python="${WORKFLOW_PYTHON:-}"
if [ -z "$workflow_python" ]; then
    workflow_python=$(git config --local --get clinicWorkflow.python || true)
fi
if [ -z "$workflow_python" ]; then
    printf '%s\n' 'Configure clinicWorkflow.python with an actual Python 3.10+ executable.' >&2
    exit 2
fi
exec "$workflow_python" tools/coding_workflow.py verify
