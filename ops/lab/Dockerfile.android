# FixFlow local Android compile gate — build image.
#
# Built with NO build context (`docker build - < Dockerfile.android`), so nothing from the
# repository (app.json, google-services.json, eas.json, keystores, .env) can enter a layer.
# The app is copied into a running container by ops/lab/android-compile.sh, never into this image.
#
# Versions are the ones the technician app's own toolchain asks for, verified 2026-11-13 from:
#   react-native 0.76.9      node_modules/react-native/gradle/libs.versions.toml
#                            (compileSdk 35, targetSdk 34, minSdk 24, buildTools 35.0.0,
#                             ndkVersion 26.1.10909125, agp 8.6.0, kotlin 1.9.25)
#                            node_modules/react-native/ReactAndroid/build.gradle.kts (CMake 3.22.1)
#   expo 52.0.49 prebuild    expo-template-bare-minimum@sdk-52 (52.0.79) android/build.gradle
#                            (same SDK/NDK/build-tools/kotlin values; Gradle wrapper 8.10.2;
#                             gradle.properties newArchEnabled=false, hermesEnabled=true)
#   JDK 17                   the JDK EAS uses for SDK 52 Android builds and AGP 8.6's minimum
#   Node 22                  what CI pins (.github/workflows/ci.yml node-version: 22)
#   cmdline-tools            https://developer.android.com/studio (file + sha256 published there)
#
# Sources: the Docker Official Image `node` (Debian bookworm), Debian's own openjdk-17 package,
# and dl.google.com for the Android command-line tools; everything else via sdkmanager.

# node 22.23.5 at the digest pulled 2026-11-13
FROM node:22-bookworm@sha256:e13726ca604184d7a91fcacab1fc09eefd642dc28e79ac34e85540dd93b78cfb

ARG CMDLINE_TOOLS_ZIP=commandlinetools-linux-15859902_latest.zip
ARG CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-17-jdk-headless unzip ccache \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/android-sdk/cmdline-tools \
 && cd /tmp \
 && curl -fsSLo tools.zip "https://dl.google.com/android/repository/${CMDLINE_TOOLS_ZIP}" \
 && echo "${CMDLINE_TOOLS_SHA256}  tools.zip" | sha256sum -c - \
 && unzip -q tools.zip -d /opt/android-sdk/cmdline-tools \
 && mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest \
 && rm tools.zip

ENV PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/build-tools/35.0.0:$PATH

# NOTE: `yes | sdkmanager --licenses` accepts the Android SDK licence agreements on the
# builder's behalf (the same agreements Android Studio and EAS's images accept). Known and
# unpinned: the Debian apt packages below and platform-tools track their current release.
RUN yes | sdkmanager --licenses > /dev/null \
 && sdkmanager --install \
      "platform-tools" \
      "platforms;android-35" \
      "build-tools;35.0.0" \
      "ndk;26.1.10909125" \
      "cmake;3.22.1" \
 && sdkmanager --list_installed

# Build-Tools 34.0.0 is AGP 8.6's default: library modules that set no buildToolsVersion use it,
# and the first gate run showed AGP downloading it mid-build (into the throwaway container
# layer, so on every run). android-compile.sh reports any such auto-install as sdk_autoinstalls.
RUN sdkmanager --install "build-tools;34.0.0" > /dev/null && sdkmanager --list_installed | grep build-tools

# ccache for the NDK C/C++ compiles: CMake >= 3.17 reads these env vars as the default
# compiler launcher, so every library's externalNativeBuild goes through it without editing
# a single gradle file. The cache directory is inside the fixflow-gradle-cache volume.
ENV CMAKE_C_COMPILER_LAUNCHER=ccache \
    CMAKE_CXX_COMPILER_LAUNCHER=ccache \
    CCACHE_DIR=/root/.gradle/ccache \
    CCACHE_MAXSIZE=5G \
    EXPO_NO_TELEMETRY=1 \
    CI=1

WORKDIR /work
