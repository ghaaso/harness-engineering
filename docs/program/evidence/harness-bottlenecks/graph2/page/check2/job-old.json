{
  "page": "../work2/index.before.html",
  "out": "old",
  "width": 1870, "height": 1280, "scheme": "light",
  "shots": [
    { "name": "dump", "steps": [ { "wait": 600 },
      { "dump": { "file": "sections.txt", "expr": "[...document.querySelectorAll('section, h2, h3')].map(e=>e.tagName+'#'+e.id+' | '+(e.tagName.startsWith('H')?e.innerText:(e.querySelector('h2,h3')||{}).innerText)).join('\\n')" } },
      { "dump": { "file": "alltext-open.txt", "expr": "(()=>{document.querySelectorAll('details').forEach(d=>d.open=true); return document.body.innerText;})()" } },
      { "dump": { "file": "charts.txt", "expr": "[...document.querySelectorAll('.chart,[id]')].map(e=>e.id).filter(Boolean).join('\\n')" } }
    ], "clip": "none" }
  ]
}
