{
  "page": "../../../../../graph-test/index.html",
  "out": "out",
  "width": 1870, "height": 1280, "scheme": "light",
  "shots": [
    { "name": "dump", "steps": [ { "wait": 600 },
      { "dump": { "file": "sections.txt", "expr": "[...document.querySelectorAll('section, #scope, h2, h3')].map(e=>e.tagName+'#'+e.id+' | '+(e.tagName.startsWith('H')?e.innerText:(e.querySelector('h2,h3')||{}).innerText)).join('\\n')" } },
      { "dump": { "file": "links.txt", "expr": "[...document.querySelectorAll('a[href]')].map(a=>a.getAttribute('href')+' | '+a.innerText.replace(/\\s+/g,' ').slice(0,120)+' | in #'+((a.closest('section,[id]')||{}).id||'')).join('\\n')" } },
      { "dump": { "file": "scope-rect.txt", "expr": "JSON.stringify({scope:document.querySelector('#scope')&&document.querySelector('#scope').getBoundingClientRect(), vh:innerHeight, firstText:document.body.innerText.slice(0,3000)})" } },
      { "dump": { "file": "visible.txt", "expr": "document.body.innerText" } },
      { "dump": { "file": "h.txt", "expr": "(()=>{document.querySelectorAll('details').forEach(d=>d.open=true); const s=document.querySelector('#h'); const tips=[...s.querySelectorAll('[data-tip]')].map(e=>'TIP: '+e.getAttribute('data-tip')); return s.innerText+'\\n'+tips.join('\\n');})()" } },
      { "dump": { "file": "k.txt", "expr": "(()=>{document.querySelectorAll('details').forEach(d=>d.open=true); const s=document.querySelector('#k'); const tips=[...s.querySelectorAll('[data-tip]')].map(e=>'TIP: '+e.getAttribute('data-tip')); return s.innerText+'\\n'+tips.join('\\n');})()" } },
      { "dump": { "file": "scope.txt", "expr": "(()=>{const s=document.querySelector('#scope'); return s?s.innerText:'NO #scope';})()" } },
      { "dump": { "file": "alltext-open.txt", "expr": "(()=>{document.querySelectorAll('details').forEach(d=>d.open=true); return document.body.innerText;})()" } }
    ], "clip": "none" },
    { "name": "first-screen", "reload": true, "steps": [ { "wait": 600 } ], "clip": "viewport" }
  ]
}
