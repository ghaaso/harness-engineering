{
  "title": "Pathway map of the reasoning library",
  "version": 1,
  "source": "docs/program/evidence/library-pathways/model-brief.md",
  "note": "One description of the model. The engine computes from it and the page draws from it. It maps and measures; it proposes no fixes.",
  "unit": "One episode: a point in the work where a result is produced and checked.",
  "cost_unit": "Cheap-call equivalents. One call by the cheap model (Sonnet) costs 1.",

  "groups": [
    { "id": "workload", "label": "Workload: what the world hands us" },
    { "id": "mechanism", "label": "Mechanism: lookup, screen, delivery, cheap attempt" },
    { "id": "gate", "label": "Gate: tests and review" },
    { "id": "ladder", "label": "Ladder: retry, Opus, Fable" },
    { "id": "capture", "label": "Capture and what happens to escapes" },
    { "id": "time", "label": "Time" }
  ],

  "parameters": [
    { "id": "p_visible", "group": "workload", "kind": "chance", "meaning": "Share of episodes where a problem shows itself, such as an error, a failing check or a stated bug." },
    { "id": "need_visible", "group": "workload", "kind": "chance", "meaning": "Among visible episodes, the share the cheap model alone would get wrong." },
    { "id": "need_latent", "group": "workload", "kind": "chance", "meaning": "Among latent episodes, the share the cheap model alone would get wrong." },
    { "id": "u_exact", "group": "workload", "kind": "chance", "meaning": "Long-run ceiling on the chance the library holds the very same problem." },
    { "id": "u_similar", "group": "workload", "kind": "chance", "meaning": "Long-run ceiling on the chance one stored entry fits after adapting." },
    { "id": "u_composite", "group": "workload", "kind": "chance", "meaning": "Long-run ceiling on the chance two or more entries each cover part of the problem." },
    { "id": "latent_coverage_factor", "group": "workload", "kind": "chance", "meaning": "Multiplier on the three ceilings for latent episodes, where the strong model's edge is mostly mistakes it never makes or records." },
    { "id": "k_fill", "group": "workload", "kind": "scale", "meaning": "Number of good entries at which coverage reaches about 63 percent of its ceiling." },
    { "id": "v_max", "group": "workload", "kind": "chance", "meaning": "Highest chance a misleading look-alike entry can be retrieved, once the library is large." },
    { "id": "k_distract", "group": "workload", "kind": "scale", "meaning": "Number of stored entries at which the look-alike chance reaches about 63 percent of its highest value." },

    { "id": "t_visible", "group": "mechanism", "kind": "chance", "meaning": "Chance a lookup happens when the problem is visible." },
    { "id": "t_latent", "group": "mechanism", "kind": "chance", "meaning": "Chance a lookup happens when nothing signals that a choice matters." },
    { "id": "c_lookup", "group": "mechanism", "kind": "cost", "pure_cost": true, "meaning": "Cost of one lookup, in cheap-call equivalents." },
    { "id": "r_exact", "group": "mechanism", "kind": "chance", "meaning": "Chance the lookup returns the stored entry when the very same problem is held." },
    { "id": "r_similar", "group": "mechanism", "kind": "chance", "meaning": "Chance the lookup returns the fitting entry when a similar one is held." },
    { "id": "r_comp_full", "group": "mechanism", "kind": "chance", "meaning": "When parts are held, chance the lookup returns all of them." },
    { "id": "r_comp_part", "group": "mechanism", "kind": "chance", "meaning": "When parts are held, chance the lookup returns only some of them." },
    { "id": "f_false", "group": "mechanism", "kind": "chance", "meaning": "Chance a misleading look-alike comes back on top when one can be retrieved." },
    { "id": "c_check_share", "group": "mechanism", "kind": "chance", "meaning": "Share of entries that carry a mechanical check that decides whether they apply." },
    { "id": "c_screen", "group": "mechanism", "kind": "cost", "pure_cost": true, "meaning": "Cost of running a mechanical check at the screen, in cheap-call equivalents." },
    { "id": "a_right", "group": "mechanism", "kind": "chance", "meaning": "Chance the cheap model accepts a good entry when it judges without a check." },
    { "id": "a_wrong", "group": "mechanism", "kind": "chance", "meaning": "Chance the cheap model accepts a wrong entry when it judges without a check." },
    { "id": "d_deliver", "group": "mechanism", "kind": "chance", "meaning": "Chance an accepted entry is in the working window at the moment it is needed." },
    { "id": "c_carry", "group": "mechanism", "kind": "cost", "pure_cost": true, "meaning": "Cost of carrying a delivered entry in the working window, in cheap-call equivalents." },
    { "id": "q_exact", "group": "mechanism", "kind": "chance", "meaning": "Chance the cheap model gets it right with a good exact entry, on a problem it would otherwise get wrong." },
    { "id": "q_similar", "group": "mechanism", "kind": "chance", "meaning": "The same chance with a good similar entry that needs adapting." },
    { "id": "q_comp", "group": "mechanism", "kind": "chance", "meaning": "The same chance with all parts of a composite entry." },
    { "id": "q_part", "group": "mechanism", "kind": "chance", "meaning": "The same chance with only some parts of a composite entry." },
    { "id": "h_harm", "group": "mechanism", "kind": "chance", "meaning": "Chance a wrong accepted entry spoils work the cheap model would otherwise get right." },
    { "id": "n_cheap", "group": "mechanism", "kind": "calls", "pure_cost": true, "meaning": "Cheap calls in one cheap attempt or one cheap retry." },

    { "id": "g_tests_visible", "group": "gate", "kind": "chance", "meaning": "Chance the tests catch a wrong output when the problem is visible." },
    { "id": "g_tests_latent", "group": "gate", "kind": "chance", "meaning": "Chance the tests catch a wrong output when the problem is latent." },
    { "id": "s_review", "group": "gate", "kind": "chance", "meaning": "Share of gate passes that include a review by Opus." },
    { "id": "g_review", "group": "gate", "kind": "chance", "meaning": "Chance a review catches a wrong output that the tests missed." },
    { "id": "c_review", "group": "gate", "kind": "calls", "pure_cost": true, "meaning": "Opus calls in one review." },

    { "id": "rho_retry", "group": "ladder", "kind": "chance", "meaning": "Chance the one cheap retry is right after the gate's feedback." },
    { "id": "c_handoff", "group": "ladder", "kind": "cost", "pure_cost": true, "meaning": "Cost of handing the work to Opus, in cheap-call equivalents." },
    { "id": "n_opus", "group": "ladder", "kind": "calls", "pure_cost": true, "meaning": "Opus calls in one Opus attempt." },
    { "id": "n_fable", "group": "ladder", "kind": "calls", "pure_cost": true, "meaning": "Fable calls in one Fable attempt." },
    { "id": "m_opus", "group": "ladder", "kind": "multiplier", "pure_cost": true, "meaning": "Price of one Opus call over one cheap call." },
    { "id": "m_fable", "group": "ladder", "kind": "multiplier", "pure_cost": true, "meaning": "Price of one Fable call over one cheap call." },
    { "id": "o_opus", "group": "ladder", "kind": "chance", "meaning": "Chance Opus is right on a problem the cheap model alone would get wrong." },
    { "id": "o_fable", "group": "ladder", "kind": "chance", "meaning": "Chance Fable is right after Opus was wrong and was caught." },

    { "id": "w_write", "group": "capture", "kind": "chance", "meaning": "Chance an entry is written after a right Opus or Fable solve." },
    { "id": "c_write", "group": "capture", "kind": "calls", "pure_cost": true, "meaning": "Calls at the solving tier needed to write one entry." },
    { "id": "e_right", "group": "capture", "kind": "chance", "meaning": "Chance a written entry is good rather than wrong." },
    { "id": "z_wrongstore", "group": "capture", "kind": "chance", "meaning": "Chance an escaped wrong output is recorded as a success and stored as an entry." },
    { "id": "l_found", "group": "capture", "kind": "chance", "meaning": "Chance an escaped wrong output is found later." },
    { "id": "R_rework", "group": "capture", "kind": "calls", "pure_cost": true, "meaning": "Opus calls needed to rework an escaped output that is found later." },
    { "id": "delta_stale", "group": "capture", "kind": "chance", "meaning": "Share of good entries that go stale in each period." },

    { "id": "episodes_per_period", "group": "time", "kind": "size", "meaning": "Number of episodes in one period." },
    { "id": "periods", "group": "time", "kind": "size", "integer": true, "run_setting": true, "meaning": "Number of periods in the time path, starting from an empty library." }
  ],

  "constraints": [
    { "id": "composite_split", "kind": "sum_at_most", "ids": ["r_comp_full", "r_comp_part"], "limit": 1, "note": "All parts and some parts cannot together exceed certainty. If a draw breaks this, both are scaled down in proportion." },
    { "id": "ceilings_split", "kind": "sum_at_most", "ids": ["u_exact", "u_similar", "u_composite"], "limit": 1, "note": "The three ceilings cannot together exceed certainty. If a draw breaks this, all three are scaled down in proportion." }
  ],

  "tiers": [
    { "id": "cheap", "label": "Cheap model (Sonnet)", "price": "1" },
    { "id": "opus", "label": "Opus", "price": "m_opus" },
    { "id": "fable", "label": "Fable", "price": "m_fable" }
  ],

  "stocks": {
    "note": "Two stocks of entries. Both start at zero. Only the library policy changes them.",
    "initial": { "E_good": 0, "E_bad": 0 },
    "labels": { "E_good": "Good entries", "E_bad": "Bad entries (wrong or stale)" },
    "values": [
      { "id": "wrong_share", "label": "Share of stored entries that are bad", "expr": "safediv(E_bad, E_good + E_bad)" },
      { "id": "fill", "label": "How full the library is toward its ceilings", "expr": "1 - exp(-E_good / k_fill)" },
      { "id": "distract", "label": "Chance a look-alike can be retrieved", "expr": "v_max * (1 - exp(-(E_good + E_bad) / k_distract))" }
    ],
    "update_note": "Each period, both stocks are updated together from their values at the start of that period.",
    "update": [
      { "id": "E_good", "expr": "E_good - delta_stale * E_good + episodes_per_period * P_strong_right * w_write * e_right" },
      { "id": "E_bad", "expr": "E_bad + delta_stale * E_good + episodes_per_period * P_strong_right * w_write * (1 - e_right) + episodes_per_period * P_escaped * z_wrongstore" }
    ]
  },

  "measures": [
    { "id": "P_strong_right", "label": "Chance of a right Opus or Fable solve", "flow_into": ["L10_opus", "L10_fable"] },
    { "id": "P_escaped", "label": "Chance a wrong output escapes the gate", "flow_into": ["L11_escaped"] }
  ],

  "attributes": [
    { "id": "kind", "label": "Kind of episode", "values": [
      { "id": "visible", "label": "Visible problem", "flags": { "visible": 1 }, "chance": "p_visible" },
      { "id": "latent", "label": "Latent problem", "flags": { "visible": 0 }, "chance": "1 - p_visible" }
    ] },
    { "id": "need", "label": "What the cheap model alone would do", "values": [
      { "id": "cheap_ok", "label": "Cheap model alone is right", "flags": { "need_wrong": 0 }, "chance": "1 - (visible * need_visible + (1 - visible) * need_latent)" },
      { "id": "cheap_wrong", "label": "Cheap model alone is wrong", "flags": { "need_wrong": 1 }, "chance": "visible * need_visible + (1 - visible) * need_latent" }
    ] },
    { "id": "held", "label": "What the library holds for it", "values": [
      { "id": "exact", "label": "The same problem", "flags": { "held_exact": 1, "held_similar": 0, "held_composite": 0, "held_nothing": 0 }, "chance": "u_exact * fill * cov" },
      { "id": "similar", "label": "One entry that fits after adapting", "flags": { "held_exact": 0, "held_similar": 1, "held_composite": 0, "held_nothing": 0 }, "chance": "u_similar * fill * cov" },
      { "id": "composite", "label": "Several entries, each covering a part", "flags": { "held_exact": 0, "held_similar": 0, "held_composite": 1, "held_nothing": 0 }, "chance": "u_composite * fill * cov" },
      { "id": "nothing", "label": "Nothing", "flags": { "held_exact": 0, "held_similar": 0, "held_composite": 0, "held_nothing": 1 }, "chance": "1 - (u_exact + u_similar + u_composite) * fill * cov" }
    ] },
    { "id": "distractor", "label": "A misleading look-alike can be retrieved", "values": [
      { "id": "yes", "label": "Yes", "flags": { "distractor": 1 }, "chance": "distract" },
      { "id": "no", "label": "No", "flags": { "distractor": 0 }, "chance": "1 - distract" }
    ] }
  ],
  "class_chance": {
    "rule": "product",
    "note": "A class's chance is the product of its four attribute chances. Held and look-alike chances come from the stocks at the start of the period. Policies without the library fix held at nothing and look-alike at no."
  },

  "derived": [
    { "id": "ok", "label": "1 when the cheap model alone would be right", "expr": "1 - need_wrong" },
    { "id": "t", "label": "Chance of a lookup for this kind", "expr": "visible * t_visible + (1 - visible) * t_latent" },
    { "id": "g_tests", "label": "Chance the tests catch a wrong output", "expr": "visible * g_tests_visible + (1 - visible) * g_tests_latent" },
    { "id": "g", "label": "Chance the gate catches a wrong output", "expr": "1 - (1 - g_tests) * (1 - s_review * g_review)" },
    { "id": "cov", "label": "Coverage multiplier for this kind", "expr": "visible + (1 - visible) * latent_coverage_factor" },
    { "id": "f", "label": "Chance a look-alike comes back on top", "expr": "f_false * distractor" },
    { "id": "r_hit", "label": "Chance the lookup returns a held entry", "expr": "held_exact * r_exact + held_similar * r_similar + held_composite * (r_comp_full + r_comp_part)" },
    { "id": "review", "label": "Expected review cost per gate pass", "expr": "s_review * c_review * m_opus" },
    { "id": "review_calls", "label": "Expected review calls per gate pass", "expr": "s_review * c_review" }
  ],

  "policies": [
    { "id": "top_first", "label": "Strong model first", "meaning": "Opus does the work directly, then Fable if the gate catches a failure. No library.", "start": "L8_opus", "flags": { "capture": 0 }, "fixed": { "held": "nothing", "distractor": "no" } },
    { "id": "cheap_ladder", "label": "Cheap model with the ladder", "meaning": "The cheap model tries first, with the gate and the ladder. No library.", "start": "L5_none", "flags": { "capture": 0 }, "fixed": { "held": "nothing", "distractor": "no" } },
    { "id": "library", "label": "Cheap model with the library", "meaning": "The cheap model with the library, the gate and the ladder. Strong solves are written to the library.", "start": "L1_trigger", "flags": { "capture": 1 }, "fixed": {} }
  ],

  "steps": [
    { "id": "L1", "label": "Trigger" },
    { "id": "L2", "label": "Result of the lookup" },
    { "id": "L3", "label": "Screen: does it apply?" },
    { "id": "L4", "label": "Delivery" },
    { "id": "L5", "label": "Cheap attempt" },
    { "id": "L6", "label": "Gate" },
    { "id": "L7", "label": "Cheap retry" },
    { "id": "L8", "label": "Opus" },
    { "id": "L9", "label": "Fable" },
    { "id": "L10", "label": "Capture" },
    { "id": "L11", "label": "Afterlife of an escape" },
    { "id": "outcome", "label": "Outcome" }
  ],

  "entry_kinds": [
    { "id": "none", "label": "No entry in hand" },
    { "id": "good_exact", "label": "Good exact entry" },
    { "id": "good_similar", "label": "Good similar entry" },
    { "id": "composite_full", "label": "Good composite entry, all parts" },
    { "id": "composite_part", "label": "Good composite entry, some parts" },
    { "id": "wrong", "label": "Wrong entry, not yet screened" },
    { "id": "wrong_accepted", "label": "Wrong entry, accepted" }
  ],

  "states": [
    { "id": "L1_trigger", "label": "Lookup or not", "step": "L1", "entry": "none", "outcome": false },
    { "id": "L2_lookup", "label": "The library answers", "step": "L2", "entry": "none", "outcome": false },
    { "id": "L3_exact", "label": "Screen a good exact entry", "step": "L3", "entry": "good_exact", "outcome": false },
    { "id": "L3_similar", "label": "Screen a good similar entry", "step": "L3", "entry": "good_similar", "outcome": false },
    { "id": "L3_full", "label": "Screen all good parts", "step": "L3", "entry": "composite_full", "outcome": false },
    { "id": "L3_part", "label": "Screen some good parts", "step": "L3", "entry": "composite_part", "outcome": false },
    { "id": "L3_wrong", "label": "Screen a wrong entry", "step": "L3", "entry": "wrong", "outcome": false },
    { "id": "L4_exact", "label": "Deliver a good exact entry", "step": "L4", "entry": "good_exact", "outcome": false },
    { "id": "L4_similar", "label": "Deliver a good similar entry", "step": "L4", "entry": "good_similar", "outcome": false },
    { "id": "L4_full", "label": "Deliver all good parts", "step": "L4", "entry": "composite_full", "outcome": false },
    { "id": "L4_part", "label": "Deliver some good parts", "step": "L4", "entry": "composite_part", "outcome": false },
    { "id": "L4_wrong", "label": "Deliver an accepted wrong entry", "step": "L4", "entry": "wrong_accepted", "outcome": false },
    { "id": "L5_none", "label": "Cheap attempt, no entry", "step": "L5", "entry": "none", "outcome": false },
    { "id": "L5_exact", "label": "Cheap attempt, good exact entry", "step": "L5", "entry": "good_exact", "outcome": false },
    { "id": "L5_similar", "label": "Cheap attempt, good similar entry", "step": "L5", "entry": "good_similar", "outcome": false },
    { "id": "L5_full", "label": "Cheap attempt, all good parts", "step": "L5", "entry": "composite_full", "outcome": false },
    { "id": "L5_part", "label": "Cheap attempt, some good parts", "step": "L5", "entry": "composite_part", "outcome": false },
    { "id": "L5_wrong", "label": "Cheap attempt, wrong entry accepted", "step": "L5", "entry": "wrong_accepted", "outcome": false },
    { "id": "L6_right", "label": "Gate: cheap output right", "step": "L6", "entry": "none", "outcome": false },
    { "id": "L6_wrong", "label": "Gate: cheap output wrong", "step": "L6", "entry": "none", "outcome": false },
    { "id": "L7_retry", "label": "Cheap retry with feedback", "step": "L7", "entry": "none", "outcome": false },
    { "id": "L7_right", "label": "Gate: retry right", "step": "L7", "entry": "none", "outcome": false },
    { "id": "L7_wrong", "label": "Gate: retry wrong", "step": "L7", "entry": "none", "outcome": false },
    { "id": "L8_handoff", "label": "Hand off to Opus", "step": "L8", "entry": "none", "outcome": false },
    { "id": "L8_opus", "label": "Opus attempt", "step": "L8", "entry": "none", "outcome": false },
    { "id": "L8_right", "label": "Gate: Opus output right", "step": "L8", "entry": "none", "outcome": false },
    { "id": "L8_wrong", "label": "Gate: Opus output wrong", "step": "L8", "entry": "none", "outcome": false },
    { "id": "L9_fable", "label": "Fable attempt", "step": "L9", "entry": "none", "outcome": false },
    { "id": "L9_right", "label": "Gate: Fable output right", "step": "L9", "entry": "none", "outcome": false },
    { "id": "L9_wrong", "label": "Gate: Fable output wrong", "step": "L9", "entry": "none", "outcome": false },
    { "id": "L10_opus", "label": "Capture after an Opus solve", "step": "L10", "entry": "none", "outcome": false },
    { "id": "L10_fable", "label": "Capture after a Fable solve", "step": "L10", "entry": "none", "outcome": false },
    { "id": "L11_escaped", "label": "Escaped output, later life", "step": "L11", "entry": "none", "outcome": false },
    { "id": "EQUAL", "label": "Accepted and right", "step": "outcome", "entry": "none", "outcome": true },
    { "id": "ESCAPED_FOUND", "label": "Wrong, escaped, found later", "step": "outcome", "entry": "none", "outcome": true },
    { "id": "ESCAPED_SILENT", "label": "Wrong, escaped, never found", "step": "outcome", "entry": "none", "outcome": true },
    { "id": "UNRESOLVED", "label": "Caught but never solved", "step": "outcome", "entry": "none", "outcome": true }
  ],

  "outcomes": [
    { "id": "EQUAL", "label": "Accepted and right", "right": true },
    { "id": "ESCAPED_FOUND", "label": "Wrong, escaped, found later", "right": false },
    { "id": "ESCAPED_SILENT", "label": "Wrong, escaped, never found", "right": false },
    { "id": "UNRESOLVED", "label": "Caught but never solved", "right": false }
  ],

  "branches": [
    { "id": "l1_lookup", "from": "L1_trigger", "to": "L2_lookup", "label": "The library is looked up", "chance": "t", "cost": "c_lookup", "tier": "cheap", "calls": "0", "limitations": [] },
    { "id": "l1_no_lookup", "from": "L1_trigger", "to": "L5_none", "label": "No lookup happens", "chance": "1 - t", "cost": "0", "tier": null, "calls": "0", "limitations": [] },

    { "id": "l2_lookalike", "from": "L2_lookup", "to": "L3_wrong", "label": "A misleading look-alike comes back on top", "chance": "f", "cost": "0", "tier": null, "calls": "0", "limitations": [] },
    { "id": "l2_exact_good", "from": "L2_lookup", "to": "L3_exact", "label": "The exact entry comes back, good", "chance": "(1 - f) * held_exact * r_exact * (1 - wrong_share)", "cost": "0", "tier": null, "calls": "0", "limitations": [] },
    { "id": "l2_exact_bad", "from": "L2_lookup", "to": "L3_wrong", "label": "The exact entry comes back, but bad", "chance": "(1 - f) * held_exact * r_exact * wrong_share", "cost": "0", "tier": null, "calls": "0", "limitations": [] },
    { "id": "l2_similar_good", "from": "L2_lookup", "to": "L3_similar", "label": "A similar entry comes back, good", "chance": "(1 - f) * held_similar * r_similar * (1 - wrong_share)", "cost": "0", "tier": null, "calls": "0", "limitations": [] },
    { "id": "l2_similar_bad", "from": "L2_lookup", "to": "L3_wrong", "label": "A similar entry comes back, but bad", "chance": "(1 - f) * held_similar * r_similar * wrong_share", "cost": "0", "tier": null, "calls": "0", "limitations": [] },
    { "id": "l2_full_good", "from": "L2_lookup", "to": "L3_full", "label": "All parts come back, good", "chance": "(1 - f) * held_composite * r_comp_full * (1 - wrong_share)", "cost": "0", "tier": null, "calls": "0", "limitations": [] },
    { "id": "l2_full_bad", "from": "L2_lookup", "to": "L3_wrong", "label": "All parts come back, but bad", "chance": "(1 - f) * held_composite * r_comp_full * wrong_share", "cost": "0", "tier": null, "calls": "0", "limitations": [] },
