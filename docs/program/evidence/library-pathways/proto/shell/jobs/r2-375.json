{
  "page": "proto/shell/index.html",
  "out": "shots/proto-shell/r2",
  "width": 375, "height": 812, "scheme": "light",
  "shots": [
    { "name": "375-top", "steps": [ { "wait": 2500 }, { "dump": { "expr": "JSON.stringify({sw:document.documentElement.scrollWidth, w:innerWidth})", "file": "375-width.txt" } } ], "clip": "viewport" },
    { "name": "375-cases", "steps": [ { "eval": "scrollTo(0, document.querySelector('#cg').offsetTop - 60); 0" }, { "wait": 300 } ], "clip": "viewport" },
    { "name": "375-cases-rows", "steps": [ { "eval": "scrollTo(0, document.querySelector('.cg-fam').offsetTop + document.querySelector('#cg').offsetTop - 120); 0" }, { "wait": 300 } ], "clip": "viewport" },
    { "name": "375-case-open", "steps": [ { "eval": "__shell.selectCase('f01-C1b'); document.querySelector('#caseInline').scrollIntoView(); scrollBy(0,-120); 0" }, { "wait": 300 } ], "clip": "viewport" },
    { "name": "375-lims", "steps": [ { "eval": "__shell.selectCase(null); document.querySelector('#lstep-2').scrollIntoView(); scrollBy(0,-200); 0" }, { "wait": 300 } ], "clip": "viewport" },
    { "name": "375-lim-open", "steps": [ { "eval": "__shell.selectLim('LIM-04'); document.querySelector('#limInline').scrollIntoView(); scrollBy(0,-200); 0" }, { "wait": 300 } ], "clip": "viewport" },
    { "name": "375-drawer", "steps": [ { "eval": "__shell.openDrawer('u_exact'); 0" }, { "wait": 400 } ], "clip": "viewport" },
    { "name": "375-menu", "steps": [ { "eval": "__shell.closeDrawer(); 0" }, { "clickSel": "#secBtn" }, { "wait": 200 } ], "clip": "viewport" }
  ]
}
