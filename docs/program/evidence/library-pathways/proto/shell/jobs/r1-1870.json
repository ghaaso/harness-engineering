{
  "page": "proto/shell/index.html",
  "out": "shots/proto-shell/r1",
  "width": 1870, "height": 1280, "scheme": "light",
  "shots": [
    { "name": "top", "steps": [ { "wait": 2500 }, { "dump": { "expr": "JSON.stringify({ready:document.documentElement.getAttribute('data-ready'), shell:!!window.__shell, sw:document.documentElement.scrollWidth})", "file": "state.txt" } } ], "clip": "viewport" },
    { "name": "cases-top", "steps": [ { "eval": "scrollTo(0, document.querySelector('#cases').offsetTop - 56); 0" }, { "wait": 200 } ], "clip": "viewport" },
    { "name": "cases-open", "steps": [ { "eval": "__shell.selectCase('f01-C1a'); scrollTo(0, document.querySelector('#cg').offsetTop - 40); 0" }, { "wait": 300 } ], "clip": "viewport" },
    { "name": "cases-col", "steps": [ { "clickSel": "#cg .stepbtn[data-col='7']" }, { "eval": "scrollTo(0, document.querySelector('#cg').offsetTop + 600); 0" }, { "wait": 300 } ], "clip": "viewport" },
    { "name": "lims-top", "steps": [ { "eval": "scrollTo(0, document.querySelector('#lims').offsetTop - 56); 0" }, { "wait": 200 } ], "clip": "viewport" },
    { "name": "lims-open", "steps": [ { "eval": "__shell.selectLim('LIM-04'); document.querySelector('#lstep-2').scrollIntoView(); scrollBy(0,-170); 0" }, { "wait": 300 } ], "clip": "viewport" },
    { "name": "lims-step4", "steps": [ { "eval": "document.querySelector('#lstep-4').scrollIntoView(); scrollBy(0,-170); 0" }, { "wait": 300 } ], "clip": "viewport" },
    { "name": "works", "clip": "#works" },
    { "name": "drawer", "steps": [ { "eval": "scrollTo(0, document.querySelector('#run').offsetTop - 56); __shell.setCur('p_visible', 0.6); __shell.openDrawer('u_exact'); 0" }, { "wait": 400 } ], "clip": "viewport" },
    { "name": "leaves", "steps": [ { "eval": "__shell.closeDrawer(); 0" } ], "clip": "#leaves" },
    { "name": "words", "clip": "#words" }
  ]
}
