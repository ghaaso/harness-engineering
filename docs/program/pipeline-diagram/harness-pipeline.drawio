<mxCell id="x0" value="THE HARNESS: THE WHOLE PIPELINE" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=76;fontColor=#0f172a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="44" width="1553.9" height="101" as="geometry"/></mxCell>
<mxCell id="x1" value="A harness is everything around the AI model. It turns one request into a checked, merged change, while spending as few tokens and as little time as it can. This is the pipeline as it is meant to work when every part works. The dot on each part says how far that part is today." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=26;fontColor=#111827;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="80" y="149" width="3306" height="38.5" as="geometry"/></mxCell>
<mxCell id="x2" value="" style="rounded=1;arcSize=3;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=2;connectable=0;" vertex="1" parent="1"><mxGeometry x="80" y="211.5" width="3300" height="884" as="geometry"/></mxCell>
<mxCell id="x3" value="THE WHOLE SYSTEM IN ONE PICTURE" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=32;fontColor=#0f172a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="233.5" width="674.1" height="46" as="geometry"/></mxCell>
<mxCell id="x4" value="Every box is one pipeline. Each is drawn in full under the same letter or number. An arrow shows what one pipeline hands to another." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=19;fontColor=#111827;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="110" y="279.5" width="1155.8" height="29.8" as="geometry"/></mxCell>
