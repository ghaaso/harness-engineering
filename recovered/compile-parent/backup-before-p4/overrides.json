  "g1-36": {
   "term": "Refuter (refute-by-default)",
   "definition": "A fresh-context agent, usually Opus at high effort, whose job is to disprove a claim, fix or design. It treats the claim as wrong until code, tests or sources show otherwise."
  },
  "g2-163": {
   "term": "Check slot (check lock, Docker-gate slot)",
   "definition": "A machine-wide permit to run the full check, so heavy checks wait their turn instead of colliding on this PC. The clinic had two [S] slots, with waits up to 2,030 s [M]."
  },
  "g3-232": {
   "term": "Monte Carlo runs (ensemble)",
   "definition": "Running a model many times with each unknown drawn from its range, to see the spread of outcomes and which unknowns matter most, instead of one answer.",
   "origin": "General statistics; I proposed it for the library pathway map."
  },
  "g1-99": {
   "definition": "A second author, separate from Dex Horthy, who added skills to the HumanLayer repositories and gave a talk on loop engineering; 97 [M] of the 1,906 [M] sweep cards come from Kyle Mistele’s material."
  }
