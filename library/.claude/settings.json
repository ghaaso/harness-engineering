    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/tier-hook.mjs\"" } ] },
      { "matcher": "Write|Edit|NotebookEdit|AskUserQuestion", "hooks": [ { "type": "command", "command": "node \"C:/Users/User/Documents/projects/harness-engineering/.claude/hooks/record-guard.mjs\"" } ] }
